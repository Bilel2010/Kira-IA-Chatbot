# ============================
# 📌 Identité de l'application
# ============================
APP_VERSION=1.0.0

# ============================
# 🔒 Sécurité
# ============================
SESSION_SECRET=change-me  # ⚠️ mets une vraie valeur secrète en prod

# ============================
# 📂 Catalogue
# ============================
CATALOG_PATH=./data/categories.json
# Filtrage optionnel (laisser vide pour tout charger)
CATALOG_FILTER_TYPE=Vente
CATALOG_FILTER_CATEGORY=Véhicules & Transport

# ============================
# 🤖 LLM (choisir UN provider)
# ============================

# --- Mode 1: MOCK (rapide, aucun modèle, utile dev) ---
#LLM_PROVIDER=mock

# --- Mode 2: LOCAL llama.cpp (modèle GGUF) ---
LLM_PROVIDER=llama_cpp_local
LLAMA_CPP_MODEL_PATH=./models/mistral-7b-instruct-v0.1.Q4_K_M.gguf
# chemin vers ton modèle
LLAMA_CPP_CTX=4096    # taille du contexte (tokens)
MODEL_N_THREADS=4      # adapte selon ton CPU

# --- Mode 3: CLOUD Mistral (SDK mistralai) ---
#LLM_PROVIDER=mistral
#MISTRAL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
#MISTRAL_MODEL=mistral-small-latest   # ou mistral-medium, mistral-large

# ============================
# ⚙️ Paramètres de génération
# ============================
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.9